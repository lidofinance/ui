{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "paths": {
      "react": ["../../node_modules/@types/react"],
      "@lidofinance/lido-shared-ui": ["../lido-shared-ui/dist/types"],
      "@lidofinance/lido-shared-ui/*": ["../lido-shared-ui/dist/types/*"]
    }
  },
  "include": ["global.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "src/recipes",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/storyFixtures.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test-utils.tsx",
    "src/vitest.setup.ts",
    "src/foundations/**"
  ]
}
