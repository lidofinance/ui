{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "paths": {
      "react": ["../../node_modules/@types/react"],
      "@lidofinance/lido-shared-ui": ["../lido-shared-ui/dist/types"],
      "@lidofinance/lido-shared-ui/*": ["../lido-shared-ui/dist/types/*"]
    }
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "node_modules",
    "dist"
  ]
}
