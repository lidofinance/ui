{
  "name": "@lidofinance/lido-app-ui",
  "version": "0.1.0",
  "homepage": "https://github.com/lidofinance/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidofinance/ui.git"
  },
  "bugs": {
    "url": "https://github.com/lidofinance/ui/issues"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./index.css": {
      "import": "./dist/esm/index.css",
      "require": "./dist/cjs/index.css"
    },
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup -c && tsc --project tsconfig.production.json && node ../lido-shared-ui/scripts/add-dts-extensions.cjs dist/types && cp dist/esm/index.css dist/index.css",
    "dev": "storybook dev -p 5557",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n SB,TEST \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --maxWorkers=2\"",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:css": "stylelint '**/*.css'",
    "types": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "icons:convert": "node ./src/icons/converter/index.cjs"
  },
  "peerDependencies": {
    "@inline-svg-unique-id/react": "^1.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "dependencies": {
    "@lidofinance/lido-shared-ui": "*",
    "classnames": "2.5.1",
    "react-jazzicon": "1.0.4"
  },
  "devDependencies": {
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.27.0",
    "@csstools/postcss-global-data": "3.0.0",
    "@inline-svg-unique-id/react": "1.2.3",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-docs": "8.6.19",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/addon-webpack5-compiler-swc": "3.0.0",
    "@storybook/manager-api": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-webpack5": "8.6.19",
    "@storybook/test": "8.6.19",
    "@storybook/test-runner": "0.22.1",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-prettier": "8.1.0",
    "@svgr/plugin-svgo": "5.5.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "15.0.7",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.2.24",
    "@types/react-dom": "18.2.9",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "10.4.21",
    "axe-core": "4.14.0",
    "axe-playwright": "2.2.2",
    "babel-plugin-react-inline-svg-unique-id": "1.5.0",
    "concurrently": "9.1.2",
    "esbuild": "0.25.12",
    "http-server": "14.1.1",
    "jsdom": "^25.0.0",
    "playwright": "1.65.1",
    "postcss-import": "16.1.0",
    "postcss-loader": "8.1.1",
    "postcss-mixins": "11.0.3",
    "postcss-nested": "7.0.2",
    "postcss-url": "10.1.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rollup": "3.30.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-postcss": "4.0.2",
    "storybook": "8.6.19",
    "tslib": "2.3.1",
    "vitest": "^3.0.0",
    "wait-on": "8.0.3"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
